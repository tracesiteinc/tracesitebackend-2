# ─────────────────────────────────────────────
#  TRACESITE BACKEND — Environment Variables
#  Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# JWT — change this to a long random string in production
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Database (SQLite file path)
DB_PATH=./tracesite.db

# VirusTotal API (optional — enhances scan accuracy)
# Get a free key at https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,https://tracesite.com

# Admin
ADMIN_EMAIL=admin@tracesite.com
